# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Venice.ai — OpenAI-compatible endpoint serving 100+ models behind one key.
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1

# --- The DM runs as two models doing two different jobs. -----------------------
#
# Mechanics: decides tool calls and nothing else. This is the one the <800ms
# budget applies to, because it is what puts dice on the table. Prose it writes
# is discarded. Wants a fast, non-reasoning, reliably tool-calling model.
#
# Measured (4 samples, real tool schema):
#   qwen3-coder-480b-a35b-instruct-turbo  563-653ms   100% valid   <- default
#   qwen3-next-80b                        540-771ms   100% valid   (invents props)
#   deepseek-v4-flash-0731-fast          1195-38478ms 100% valid   (bad tail)
DM_MODEL_TOOLS=qwen3-coder-480b-a35b-instruct-turbo

# Narration: writes the prose, with the engine's actual results as context. Runs
# while the dice are still animating, so it is allowed to be slow. Wants the best
# writer you can afford. Keep this on ONE model — narration split across models
# makes tone drift audible between turns (design doc §10).
DM_MODEL_PROSE=claude-opus-5

# Legacy single-model setting. Only used as the fallback for DM_MODEL_PROSE.
# DM_MODEL=

# --- TTS (T9). Web Speech API is the placeholder until these are set. ---------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NARRATOR=
ELEVENLABS_VOICE_GOBLIN=
