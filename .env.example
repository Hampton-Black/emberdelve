# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Venice.ai — OpenAI-compatible endpoint serving 100+ models behind one key.
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1

# The DM model. A config string, never a literal in code — T13 A/Bs this.
# Strong tool-callers:  claude-opus-5 | grok-4-6 | deepseek-v4-pro | zai-org-glm-5-2
# Cheap:                deepseek-v4-flash  (~49x cheaper per session)
# Uncensored + tools:   venice-uncensored-role-play | venice-uncensored-1-2
# Any model MUST report supportsFunctionCalling AND supportsResponseSchema.
DM_MODEL=claude-opus-5

# ElevenLabs (T9). Web Speech API is the placeholder until these are set.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NARRATOR=
ELEVENLABS_VOICE_GOBLIN=
