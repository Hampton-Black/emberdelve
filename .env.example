# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Venice.ai — OpenAI-compatible endpoint serving 100+ models behind one key.
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1

# --- The DM runs as two models doing two different jobs. -----------------------
#
# Mechanics: decides tool calls and nothing else. This is the one the
# first-feedback budget applies to, because it is what puts dice on the table.
# Prose it writes is discarded, so a model that invents props is fine here — it
# never writes narration. Wants fast, non-reasoning, reliably tool-calling.
#
# Measured (4 samples, real tool schema; see AGENTS.md for the full table):
#   qwen3-next-80b                        540-771ms   100% valid   <- default
#   qwen3-coder-480b-a35b-instruct-turbo  563ms-66s   100% valid   DISQUALIFIED
#   deepseek-v4-flash-0731-fast          1195-38478ms 100% valid   DISQUALIFIED
#
# Both disqualifications are tail latency, not correctness: bimodal stalls with
# no error and full quota remaining. One freeze ruins a five-minute session.
DM_MODEL_TOOLS=qwen3-next-80b

# Narration: writes the prose, with the engine's actual results as context. Runs
# while the dice are still animating, so it is allowed to be slow — but only on a
# turn that rolled dice; see AGENTS.md on tool-free turns. Wants the best writer
# you can afford. Keep this on ONE model — narration split across models makes
# tone drift audible between turns (design doc §10).
#
# The M0 playtests ran on venice-uncensored-role-play, which cannot call a tool
# and does not need to. That is the tone m0-evaluation.md judged.
DM_MODEL_PROSE=claude-opus-5

# Optional. Sent only on the prose client as Venice reasoning_effort.
# Gemini 3.8 Flash cannot turn thinking off; "low" is the floor (default is medium).
# Leave unset for models that do not support the parameter (a bad value 400s the turn).
# DM_REASONING_EFFORT_PROSE=low

# Legacy single-model setting. Only used as the fallback for DM_MODEL_PROSE.
# DM_MODEL=

# --- TTS (T9). Web Speech API is the placeholder until these are set. ---------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NARRATOR=
ELEVENLABS_VOICE_GOBLIN=
